# DreamGraph Engine Configuration — LM Studio preset
# Per-instance environment settings. Uncomment and edit as needed.
# Values here override global environment variables.
#
# Provider: jan (local Jan/llama.cpp) | ollama (local) | lmstudio (local) | openai (API) | anthropic (Claude API) | sampling (MCP client) | none

# --- LM Studio (local OpenAI-compatible server, default port 1234) ---
# Load a model in LM Studio's UI and start its server, then set the model id below.
DREAMGRAPH_LLM_PROVIDER=lmstudio
DREAMGRAPH_LLM_URL=http://localhost:1234/v1
DREAMGRAPH_LLM_API_KEY=lm-studio
# Replace with the model id LM Studio shows for your loaded model
DREAMGRAPH_LLM_MODEL=

# --- Optional: Ollama (commented preset for symmetry) ---
# DREAMGRAPH_LLM_PROVIDER=ollama
# DREAMGRAPH_LLM_URL=http://localhost:11434
# DREAMGRAPH_LLM_MODEL=qwen3:8b

# Base tuning
# DREAMGRAPH_LLM_TEMPERATURE=0.7
# DREAMGRAPH_LLM_MAX_TOKENS=2048

# Architect — interactive standalone Architect chat
# DREAMGRAPH_LLM_ARCHITECT_ADAPTER=native_api_tool_loop
# DREAMGRAPH_ARCHITECT_SELECTED_PLAN_ID=
# DREAMGRAPH_LLM_ARCHITECT_MODEL=
# DREAMGRAPH_LLM_ARCHITECT_TEMPERATURE=0.7
# DREAMGRAPH_LLM_ARCHITECT_MAX_TOKENS=4096
# Token economy is enabled by default per instance. Set DREAMGRAPH_ARCHITECT_TOKEN_ECONOMY=false to request full-context mode for troubleshooting or benchmarks.
DREAMGRAPH_ARCHITECT_PREAMBLE_COMPILER=true
DREAMGRAPH_ARCHITECT_TOKEN_ECONOMY=true
DREAMGRAPH_ARCHITECT_TOKEN_ECONOMY_SOFT_TARGET=16384

# Dreamer — creative dream cycle generation
# DREAMGRAPH_LLM_DREAMER_TEMPERATURE=0.9
# DREAMGRAPH_LLM_DREAMER_MAX_TOKENS=10240

# Normalizer — validation / truth-filter pass
# DREAMGRAPH_LLM_NORMALIZER_TEMPERATURE=0.1
# DREAMGRAPH_LLM_NORMALIZER_MAX_TOKENS=4096

# First-cycle cold-load — bump if your model takes >30s to warm up
# DG_DREAM_TIMEOUT_MS=120000

# ===================================================================
# ADVANCED TUNING — for experienced users only.
# These control cognitive engine internals. The defaults work well
# for most projects. Only change them if you know what you're doing.
# ===================================================================

# --- Promotion & Retention Thresholds ---
# Minimum combined confidence for edge promotion to validated graph
# DG_PROMOTION_CONFIDENCE=0.62
# Minimum plausibility score for promotion
# DG_PROMOTION_PLAUSIBILITY=0.45
# Minimum evidence score for promotion
# DG_PROMOTION_EVIDENCE=0.4
# Minimum distinct evidence signals for promotion
# DG_PROMOTION_EVIDENCE_COUNT=2
# Minimum plausibility for retention as latent (below = rejected)
# DG_RETENTION_PLAUSIBILITY=0.35
# Maximum contradiction score before rejection
# DG_MAX_CONTRADICTION=0.3

# --- Dream Decay ---
# Edge time-to-live in dream cycles (removed when TTL reaches 0)
# DG_DECAY_TTL=8
# Confidence reduction per cycle if not reinforced
# DG_DECAY_RATE=0.05
# Reinforcement memory TTL (cycles of inactivity before forgetting)
# DG_MEMORY_TTL_CYCLES=30

# --- Tension System ---
# Max active (unresolved) tensions
# DG_MAX_ACTIVE_TENSIONS=200
# Default TTL for new tensions (cycles before auto-expire)
# DG_TENSION_TTL=30
# Urgency decay per cycle for non-recurring tensions
# DG_TENSION_URGENCY_DECAY=0.01

# --- Adaptive Dream Strategy ---
# Consecutive 0-yield cycles before a strategy gets benched
# DG_BARREN_THRESHOLD=3
# Cycles between probe runs for benched strategies
# DG_PROBE_INTERVAL=6
# Strategy yield history length
# DG_STRATEGY_HISTORY=12
# LLM dream budget as fraction of total (0.0-1.0)
# DG_LLM_BUDGET=0.35
# PGO wave budget as fraction of total (0.0-1.0)
# DG_PGO_BUDGET=0.15
# Max edges the orphan_bridging strategy may propose per dream cycle
# DG_ORPHAN_BUDGET=20

# --- Normalizer Tuning ---
# Max edges per LLM semantic validation batch
# DG_NORMALIZER_BATCH_SIZE=20
# Minimum confidence for LLM semantic evaluation of latent edges
# DG_NORMALIZER_LLM_THRESHOLD=0.35

# --- Repository Mapping ---
# JSON object mapping additional repository IDs to absolute local paths.
# These repositories become available to DreamGraph code, git, and scan tools.
# The attached project_root is auto-registered separately, so project_root and repos are not the same concept.
# Example:
# DREAMGRAPH_REPOS={"dashboard":"C:/Users/name/source/repos/dashboard","api":"C:/Users/name/source/repos/api"}
# DREAMGRAPH_REPOS={}
#
# --- Database ---
# PostgreSQL connection string used by database schema/query tools
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Max concurrent PostgreSQL connections
# DG_DB_MAX_CONNECTIONS=3
# Statement timeout (ms)
# DG_DB_STATEMENT_TIMEOUT=5000
# Operation timeout (ms) — hard cap on entire query_db_schema
# DG_DB_OPERATION_TIMEOUT=10000
#
# --- Optional Novelty Features ---
# Enable the standalone Architect Doom emulator tab (disabled by default).
# The tab accepts user-provided local .jsdos bundles; DreamGraph ships no proprietary Doom data.
#
# --- Plugin System ---
# Enable in-process plugins.
# Trusted plugins run with full host process privileges.
# Only enable if you trust the plugin code.
# DG_ALLOW_INPROCESS_PLUGINS=true
#
# Enable optional denylist fetch (disabled by default).
# Performs a read-only HTTP GET to retrieve a signed list of known malicious plugins from nofs.ai.
# No plugin, instance, or user data is sent. No request body is included.
# Standard network metadata (e.g. IP address) is visible as with any HTTPS request.
# DG_FETCH_PLUGIN_BLACKLIST=false
